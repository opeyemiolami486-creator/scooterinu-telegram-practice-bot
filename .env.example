# Create a bot with @BotFather and keep its token private.
TELEGRAM_BOT_TOKEN=
# Optional: restrict the bot to one private Telegram chat ID.
TELEGRAM_ALLOWED_CHAT_ID=
# The public game API; only change this for a local test server.
GAME_BASE_URL=https://scooterinu.xyz
# Persist this directory to retain per-user device cookies and name bindings.
DATA_DIR=./data
# Maximum run tokens requested for one /play search.
MAX_RUN_ATTEMPTS=30
# Minimum seconds between run-token requests.
RUN_START_INTERVAL_SECONDS=10
LOG_LEVEL=INFO
